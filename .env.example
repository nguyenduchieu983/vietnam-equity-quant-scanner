# Copy to .env for local use; /etc/quant-vn.env for production, mode 0640.
NODE_ENV=development
PORT=3000
DATA_MODE=demo
DATABASE_URL=postgresql://quant:CHANGE_ME@127.0.0.1:5432/quant_demo
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Generate hash: node -e "console.log(require('crypto').scryptSync('your-password','your-salt',64).toString('hex'))"
ADMIN_PASSWORD_SALT=REPLACE_WITH_RANDOM_SALT
ADMIN_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
