{
  "name": "vietnam-equity-quant-scanner",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/api", "apps/web", "packages/contracts"],
  "engines": { "node": ">=22.12 <23" },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps/api/src apps/api/test apps/web/src packages/contracts/src",
    "test": "npm run test --workspace @quant/api",
    "dev:api": "npm run dev --workspace @quant/api",
    "dev:web": "npm run dev --workspace @quant/web"
  },
  "devDependencies": { "typescript": "5.9.3", "@types/node": "22.18.6", "eslint": "10.13.0", "typescript-eslint": "8.72.0", "playwright": "1.64.1" },
  "overrides": { "js-yaml": "5.5.0" }
}
